classDiagram
    class Usuario {
        +int id_usuario
    }

    class Pergunta {
        +int id_pergunta
        +string texto
        +int id_usuario
    }

    class Resposta {
        +int id_resposta
        +int id_pergunta
        +string texto
    }

    class Voto {
        <<nova>>
        +int id_voto
        +int id_pergunta
        +int id_usuario
        +string tipo
    }

    class Tag {
        <<nova>>
        +int id_tag
        +string nome
    }

    Usuario "1" --> "0..*" Pergunta : faz
    Pergunta "1" --> "0..*" Resposta : recebe
    Usuario "1" --> "0..*" Voto : realiza
    Pergunta "1" --> "0..*" Voto : recebe
    Pergunta "0..*" --> "0..*" Tag : classificada por